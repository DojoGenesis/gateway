[Unit]
Description=Dojo Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dojo
Group=dojo
ExecStart=/usr/local/bin/dojo-gateway -config /etc/dojo/config.yaml
WorkingDirectory=/var/lib/dojo
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Secrets and provider keys (JWT_SECRET, ANTHROPIC_API_KEY, GitHub OAuth creds).
# Assignments below this line win over the file, which is why the fixed paths and
# ENVIRONMENT are set here rather than left to the operator.
EnvironmentFile=-/etc/dojo/env

# This unit IS the production deployment, so declare it. Two things depend on it:
# the JWT-secret startup gate (the gateway refuses to run on the built-in
# development secret in production) and the development-only legacy token shim in
# validateToken, which is inert unless ENVIRONMENT is production. Leaving this
# unset makes both silently permissive.
Environment="ENVIRONMENT=production"

# Loopback only (DGS-113). Caddy on this host is the only intended client
# (reverse_proxy localhost:7340); nothing should reach :7340 from off the box.
# The binary defaults to this already; it is written here so the unit states
# the intent. It does NOT stop /etc/dojo/env from widening it: per
# systemd.exec(5), values from EnvironmentFile= override Environment= whatever
# their order — so keep GATEWAY_BIND_HOST out of that file. Releases before the
# DGS-113 fix ignore this variable and bind every interface.
Environment="GATEWAY_BIND_HOST=127.0.0.1"

Environment="SYSTEM_PROMPT_FILE=/etc/dojo/system-prompt.md"
Environment="MEMORY_DB_PATH=/var/lib/dojo/memory.db"
Environment="DOJO_CAS_PATH=/var/lib/dojo/skills.db"

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dojo

[Install]
WantedBy=multi-user.target
