{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dojogenesis.com/kata-ai/v1/kata-ai-triage-brain-dump/input.schema.json",
  "title": "kata-ai-triage-brain-dump input",
  "description": "Raw brain-dump items -> category, priority score, breakdown per item.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "raw_text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "raw_text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
