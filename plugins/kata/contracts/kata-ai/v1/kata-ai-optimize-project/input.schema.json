{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dojogenesis.com/kata-ai/v1/kata-ai-optimize-project/input.schema.json",
  "title": "kata-ai-optimize-project input",
  "description": "Goal + its tasks -> optimization suggestions.",
  "type": "object",
  "properties": {
    "goal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "motivation_why": {
          "type": "string",
          "maxLength": 1000
        },
        "desired_outcome": {
          "type": "string",
          "maxLength": 1000
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "due_date": {
                "type": "string",
                "maxLength": 40
              },
              "completed": {
                "type": "boolean"
              },
              "completed_at": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "status": {
            "$ref": "../_defs.schema.json#/$defs/TaskStatus"
          },
          "time_needed": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 480
          }
        },
        "required": [
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "goal",
    "tasks"
  ],
  "additionalProperties": false
}
